# Deployment environment: copy to `.env` next to compose.yaml, fill in real
# values, and never commit it (the client secret is a shared credential).
# Compose reads this file automatically; deploy/update.sh honors the same
# variables. The runbook is docs/DEPLOY_LIGHTSAIL.md.

# ---- Container ----
IMAGE_TAG=latest
SERVICES=schedule
# Public socket mapping. Behind the bundled Caddy, bind loopback only so TLS on
# 443 is the only public entry point:
PUBLIC_PORT=127.0.0.1:8080

# ---- Identity (AUTH_PROVIDER=oidc) ----
# The coordinates come from the client entry registered on the OIDC issuer
# (docs/DEPLOY_LIGHTSAIL.md, "Register the app as an OIDC client").
AUTH_PROVIDER=oidc
OIDC_ISSUER=https://sso.harisskiadas.com
OIDC_CLIENT_ID=major-vis
OIDC_CLIENT_SECRET=replace-with-the-registered-client-secret
# Must match the registered redirect URI byte-for-byte:
OIDC_REDIRECT_URI=https://catalog.harisskiadas.com/api/auth/callback
PUBLIC_ORIGIN=https://catalog.harisskiadas.com
# Behind TLS (Caddy) always true; plain-http local runs use false:
COOKIE_SECURE=true

# ---- Directory (optional) ----
# Default email domain: bare usernames typed at sign-in or in access lists
# canonicalize to name@domain, so "cskiadas" and "cskiadas@hanover.edu" are
# the same account.
# AUTH_DOMAIN=hanover.edu
# Administrators (canonical usernames, comma-separated) who maintain the user
# directory: real names and the departments each user belongs to. Non-owner
# suggestions are scoped to a user's departments, so populate the directory
# (via the in-app Directory dialog) before delegating suggestion work.
# ADMIN_USERNAMES=

# ---- Bundled Caddy (proxy profile) ----
# Uncomment both to serve TLS on 80/443 for APP_DOMAIN:
# COMPOSE_PROFILES=proxy
# APP_DOMAIN=catalog.harisskiadas.com
