{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test",
    "test:data": "python3 test/test_data.py",
    "validate:catalog": "node packages/catalog-contract/validate.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,html,css}\"",
    "format:check": "prettier --check \"**/*.{js,html,css}\""
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "3.3.3"
  }
}